# Use sqlite locally (no Docker required). Switch to postgres for docker-compose.
DB_DRIVER=sqlite
DB_DSN=whatsinmylibrary.db

# Postgres (docker-compose)
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=postgres password=postgres dbname=booksite port=5432 sslmode=disable

# Vercel demo uses ephemeral SQLite in /tmp automatically (no env vars required).
# For a persistent production database, add a Neon store or set DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-in-production
DEV_AUTH=true
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional — leave blank to use dev login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Set to true to wipe stories/chapters and re-seed the catalog
SEED_FORCE=false
